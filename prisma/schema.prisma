  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id])
  churchId String
  church   Church        @relation(fields: [churchId], references: [id])

  // Salary details
  positionId String
  position   PayrollPosition @relation(fields: [positionId], references: [id])
