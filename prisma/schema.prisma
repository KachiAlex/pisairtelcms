// AI Assistant - Notification System
enum NotificationType {
  BIRTHDAY
  ANNIVERSARY
  FOLLOW_UP
  INACTIVITY
  NEW_MEMBER
  PRAYER_UPDATE
  EVENT_REMINDER
  GIVING_CAMPAIGN
  CARE_ALERT
  CUSTOM
  // Real-time notification types (migrated from notifications collection)
  INFO
  SUCCESS
  WARNING
  ERROR
  REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  DISMISSED
  ACTED_ON
}

model Notification {
  id           String             @id @default(cuid())
  churchId     String
  church       Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId       String? // Target user (null = church-wide)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  title        String
  message      String
  actionUrl    String? // Optional URL for action (e.g., /members/xxx)
  actionLabel  String? // Optional button label
  link         String? // Legacy link field (Firestore notifications)
  icon         String? // Legacy icon field (Firestore notifications)
  read         Boolean            @default(false)
  readAt       DateTime?
  deleted      Boolean            @default(false)
  deletedAt    DateTime?
  metadata     Json? // Extra context (e.g., { age: 30, years: 5 })
  scheduledFor DateTime           @default(now()) // When the notification should be shown
  sentAt       DateTime?
  dismissedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Legacy Firestore data preservation
  firestoreData Json?

  @@index([churchId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
}

