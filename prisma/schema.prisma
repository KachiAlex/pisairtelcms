  note           String?
  createdAt      DateTime @default(now())

  firestoreData Json?

  @@index([postId])
  @@index([churchId])
}

// Google OAuth state tokens (from church_google_oauth_states; doc id = state)
model ChurchGoogleOauthState {
  id        String   @id @default(cuid())
  state     String   @unique
  churchId  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  firestoreData Json?

  @@index([state])
}

// ============ Digital School ============

model DigitalCourse {
  id               String   @id @default(cuid())
  churchId         String
  church           Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  accessType       String   @default("open")
  mentors          String[]
  estimatedHours   Float?
  coverImageUrl    String?
  tags             String[]
  status           String   @default("draft")
  pricing          Json?
  certificateTheme Json?
  createdBy        String
  updatedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sections       DigitalCourseSection[]
  modules        DigitalCourseModule[]
  lessons        DigitalCourseLesson[]
  enrollments    DigitalCourseEnrollment[]
  accessRequests DigitalCourseAccessRequest[]
  exams          DigitalCourseExam[]

  firestoreData Json?

  @@index([churchId])
  @@index([status])
}

model DigitalCourseSection {
  id             String        @id @default(cuid())
  courseId       String
  course         DigitalCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  order          Int           @default(0)
  estimatedHours Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  modules DigitalCourseModule[]

  firestoreData Json?

  @@index([courseId])
}

model DigitalCourseModule {
  id               String               @id @default(cuid())
  courseId         String
  course           DigitalCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId        String
  section          DigitalCourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  order            Int                  @default(0)
  estimatedMinutes Int?
  videoUrl         String?
  audioUrl         String?
  audioFileName    String?
  audioStoragePath String?
  bookUrl          String?
  bookFileName     String?
  bookStoragePath  String?
  contentType      String?
  textContent      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  lessons DigitalCourseLesson[]

  firestoreData Json?

  @@index([courseId])
  @@index([sectionId])
}

model DigitalCourseLesson {
  id             String              @id @default(cuid())
  courseId       String
  course         DigitalCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId       String
  module         DigitalCourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  videoUrl       String?
  audioUrl       String?
  attachmentUrls String[]
  transcript     String?
  order          Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  firestoreData Json?

  @@index([courseId])
  @@index([moduleId])
}

model DigitalCourseEnrollment {
  id                     String        @id @default(cuid())
  courseId               String
  course                 DigitalCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId               String
  status                 String        @default("active")
  progressPercent        Float         @default(0)
  moduleProgress         Json?
  badgeIssuedAt          DateTime?
  certificateUrl         String?
  certificateStoragePath String?
  certificateIssuedAt    DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  firestoreData Json?

  @@unique([courseId, userId])
  @@index([userId])
  @@index([churchId])
  @@index([status])
}

model DigitalCourseAccessRequest {
  id           String        @id @default(cuid())
  courseId     String
  course       DigitalCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String?
  status       String        @default("pending")
  reviewerId   String?
  reviewerNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  firestoreData Json?

  @@index([courseId])
  @@index([userId])
  @@index([status])
}

model DigitalCourseExam {
  id               String        @id @default(cuid())
  courseId         String
  course           DigitalCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId        String
  moduleId         String?
  title            String
  description      String?
  timeLimitMinutes Int?
  questionCount    Int           @default(0)
  status           String        @default("draft")
  uploadMetadata   Json?
  retakePolicy     Json?
  createdBy        String
  updatedBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  questions DigitalExamQuestion[]
  attempts  DigitalExamAttempt[]

  firestoreData Json?

  @@index([courseId])
  @@index([sectionId])
}

model DigitalExamQuestion {
  id              String            @id @default(cuid())
  examId          String
  exam            DigitalCourseExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseId        String
  moduleId        String?
  question        String
  options         String[]
  correctOption   Int
  explanation     String?
  weight          Float             @default(1)
  durationSeconds Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  firestoreData Json?

  @@index([examId])
  @@index([courseId])
}

model DigitalExamAttempt {
  id             String            @id @default(cuid())
  examId         String
  exam           DigitalCourseExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseId       String
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String            @default("in_progress")
  score          Float?
  totalQuestions Int?
  startedAt      DateTime          @default(now())
  submittedAt    DateTime?
  responses      Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  firestoreData Json?

  @@index([examId])
  @@index([userId])
  @@index([courseId])
}

// Generic analytics payloads (meeting/livestream analytics, tracked events)
model AnalyticsRecord {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  kind  String // "meeting" | "livestream" | "event"
  refId String? // underlying entity id (meetingId, livestreamId, eventId)
  date  DateTime @default(now())
  data  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firestoreData Json?

  @@index([churchId, kind, date])
  @@index([refId])
}

// Member engagement point events
model EngagementEvent {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime @default(now())
  type     String // "message" | "comment" | "reaction" | "donation" | "attendance" | "volunteer"
  points   Int      @default(0)
  metadata Json?

  createdAt DateTime @default(now())

  firestoreData Json?

  @@index([churchId, date])
  @@index([userId])
}
